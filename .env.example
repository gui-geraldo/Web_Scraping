# Porta em que a interface web/API vai escutar
APP_PORT=8000

# Fuso horário (usado nos logs e agendamentos)
TZ=America/Sao_Paulo

# Caminho dos dados (banco SQLite + logs). Não precisa mudar no Docker.
DATA_DIR=/data

# Opcional: senha simples para proteger a interface (deixe vazio para sem login).
# Se preenchido, a UI pedirá esse token no primeiro acesso.
ACCESS_TOKEN=
