# Porta em que a interface web/API vai escutar
APP_PORT=8000

# Fuso horário (usado nos logs e agendamentos)
TZ=Europe/Madrid

# Caminho dos dados (banco SQLite + logs). Não precisa mudar no Docker.
DATA_DIR=/data

# Opcional: senha simples para proteger a interface (deixe vazio para sem login).
# Se preenchido, a UI pedirá esse token no primeiro acesso.
ACCESS_TOKEN=

# Modo do navegador. No servidor (Docker) deixe "false" — roda em modo gráfico
# via Xvfb, que é bem menos detectável por anti-bots. Use "true" só para
# desenvolver localmente sem abrir janela do navegador.
HEADLESS=false

# Porta de acesso ao VNC pelo navegador (para resolver captcha manualmente).
NOVNC_PORT=6080

# Senha do VNC. Deixe vazio para sem senha (use só em rede local confiável).
# Recomendado definir uma senha se a porta 6080 ficar exposta.
VNC_PASSWORD=
